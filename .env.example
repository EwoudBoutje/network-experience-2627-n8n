# Voorbeeldconfiguratie voor de centrale n8n-installatie
# Kopieer dit bestand naar .env en vul de geheime waarden zelf in.

GENERIC_TIMEZONE=Europe/Brussels
N8N_VERSION=latest
N8N_SANDBOX_VERSION=1.3.1
POSTGRES_DB=n8n_database
POSTGRES_USER=n8n_gebruiker

# Genereer unieke, sterke waarden voor deze geheimen.
POSTGRES_PASSWORD=VUL_HIER_EEN_STERK_WACHTWOORD_IN
N8N_ENCRYPTION_KEY=VUL_HIER_EEN_UNIEKE_ENCRYPTION_KEY_IN
N8N_RUNNERS_AUTH_TOKEN=VUL_HIER_EEN_UNIEKE_RUNNER_TOKEN_IN
SEARXNG_SECRET=VUL_HIER_EEN_UNIEKE_SECRET_IN
