{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "deployment_spec.schema.json",
  "title": "Deployment-spec (schema_version 1)",
  "description": "Contract tussen de n8n-workflow, Terraform en Ansible. n8n bouwt deze spec (node 'Spec valideren') en bewaart ze in infra_agent.deployments.spec. Terraform krijgt alleen VM's en hardware (geen gebruikers); Ansible krijgt per VM de rollen en gebruikers.",
  "type": "object",
  "required": ["schema_version", "deployment_id", "naam", "aanvrager_email", "access_mode", "users", "proxmox", "groups"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "deployment_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,38}[a-z0-9]$" },
    "naam": { "type": "string", "maxLength": 80 },
    "aanvrager_email": { "type": "string", "format": "email" },
    "beschrijving": { "type": "string", "maxLength": 2000 },
    "ends_at": { "type": ["string", "null"], "format": "date-time", "description": "null = geen automatische opruiming" },
    "access_mode": {
      "enum": ["per_vm", "all", "none"],
      "description": "per_vm: elke gebruiker een eigen VM (één groep, aantal = aantal gebruikers); all: alle gebruikers op alle VM's; none: alleen beheerderstoegang"
    },
    "users_sudo": { "type": "boolean" },
    "users": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": ["name", "ssh_public_key"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z_][a-z0-9_-]{0,31}$" },
          "ssh_public_key": { "type": "string", "pattern": "^(ssh-ed25519|ecdsa-sha2-nistp(256|384|521)|ssh-rsa) [A-Za-z0-9+/=]+( .*)?$" }
        }
      }
    },
    "proxmox": {
      "type": "object",
      "required": ["node", "storage", "bridge", "pool"],
      "additionalProperties": false,
      "properties": {
        "node": { "type": "string", "description": "Uit cfg.allowed_nodes" },
        "storage": { "type": "string", "description": "Uit cfg.allowed_storages" },
        "bridge": { "type": "string", "description": "Vast: cfg.bridge" },
        "vlan": { "type": ["integer", "null"], "description": "Vast: cfg.vlan" },
        "pool": { "type": "string", "description": "Altijd deploy-<deployment_id>" }
      }
    },
    "groups": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "description": "VM-groepen; VM-sleutels worden <prefix>01, <prefix>02, ...",
      "items": {
        "type": "object",
        "required": ["prefix", "count", "template_vmid", "cpu", "memory_mb", "disk_gb", "roles"],
        "additionalProperties": false,
        "properties": {
          "prefix": { "type": "string", "pattern": "^[a-z][a-z0-9]{0,11}$" },
          "count": { "type": "integer", "minimum": 1, "maximum": 50 },
          "template_vmid": { "type": "integer", "description": "Uit cfg.templates" },
          "cpu": { "type": "integer", "minimum": 1 },
          "memory_mb": { "type": "integer", "minimum": 512 },
          "disk_gb": { "type": "integer", "minimum": 4 },
          "roles": { "type": "array", "uniqueItems": true, "items": { "enum": ["webserver", "docker"] }, "description": "Moet overeenkomen met ansible/catalog.yml" },
          "role_vars": { "type": "object" }
        }
      }
    },
    "toelichting": { "type": "string", "description": "Uitleg van de AI-agent bij zijn keuzes" }
  }
}
