# /etc/infra-agent/config.env op de Terraform-VM (root:tfrunner, 0640).
# Wordt door systemd ingelezen voor infra-tf-mcp.service.

# --- MCP-server ---
MCP_HOST=0.0.0.0
MCP_PORT=8001
# Bearer-tokens (openssl rand -hex 32), elk minstens 32 tekens.
MCP_TOKEN_AGENT=VUL_IN_TOKEN_VOOR_N8N
MCP_TOKEN_ANSIBLE=VUL_IN_TOKEN_VOOR_ANSIBLE_MCP

# --- Wat de agent mag kiezen ---
ALLOWED_NODES=pve1
ALLOWED_STORAGES=local-lvm
# id=omschrijving, gescheiden door ;  (enkele quotes: systemd laat de inhoud dan ongemoeid)
TEMPLATES='9000=Debian 13 genericcloud met qemu-guest-agent'
BRIDGE=vmbr1
# Leeg = geen VLAN-tag
VLAN=120
# Rollen en hun variabelen (moet overeenkomen met ansible/catalog.yml)
ROLES_JSON='{"webserver": {"install_php": "bool"}, "docker": {}}'

# --- Grenzen ---
MAX_VMS=40
MAX_CPU=4
MAX_MEMORY_MB=8192
MAX_DISK_GB=100
MAX_TOTAL_MEMORY_MB=131072
MAX_DAYS=365
# VMID-blokken: slot n = VMID_BASE + n*VMIDS_PER_DEPLOYMENT ... +49
VMID_BASE=5000
VMIDS_PER_DEPLOYMENT=50
MAX_SLOTS=20

# --- Goedkeuring ---
# email: eenmalige code per plan naar APPROVERS (aanbevolen)
# token: vast beheerderstoken APPROVAL_TOKEN dat de gebruiker in de chat geeft
APPROVAL_MODE=email
APPROVERS=beheer@school.example
APPROVAL_TOKEN=
APPROVAL_TTL_HOURS=24

# --- SMTP (voor APPROVAL_MODE=email) ---
SMTP_HOST=smtp.school.example
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=infra-agent@school.example
