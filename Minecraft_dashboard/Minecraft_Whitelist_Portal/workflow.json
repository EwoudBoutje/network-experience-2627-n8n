    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH previous AS (\n    SELECT minecraft_username AS old_username\n    FROM minecraft_registrations\n    WHERE r_number = $1\n),\nupsert AS (\n    INSERT INTO minecraft_registrations (\n        r_number,\n        minecraft_username,\n        active,\n        registered_at,\n        updated_at\n    )\n    VALUES (\n        $1,\n        $2,\n        TRUE,\n        CURRENT_TIMESTAMP,\n        CURRENT_TIMESTAMP\n    )\n    ON CONFLICT (r_number)\n    DO UPDATE SET\n        minecraft_username = EXCLUDED.minecraft_username,\n        active = TRUE,\n        updated_at = CURRENT_TIMESTAMP\n    RETURNING r_number, minecraft_username\n)\nSELECT\n    upsert.r_number,\n    upsert.minecraft_username AS username,\n    previous.old_username\nFROM upsert\nLEFT JOIN previous ON TRUE;",
        "options": {
          "queryReplacement": "={{ [$json.rNumber, $json.username] }}"
        }
      },
