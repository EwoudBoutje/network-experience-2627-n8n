    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst headers = data.headers ?? {};\nconst body = data.body ?? {};\n\nconst rNumber =\n    headers['x-authentik-username'] ??\n    headers['x-authentik-user'] ??\n    'r0982191';\n\nconst username = String(body.minecraft_username ?? '').trim();\n\nif (!/^[A-Za-z0-9_]{3,16}$/.test(username)) {\n    return [{\n        json: {\n            success: false,\n            message: 'Ongeldige Minecraft-username. Gebruik 3 tot 16 letters, cijfers of underscores.'\n        }\n    }];\n}\n\nreturn [{\n    json: {\n        success: true,\n        rNumber,\n        username\n    }\n}];"
      },
