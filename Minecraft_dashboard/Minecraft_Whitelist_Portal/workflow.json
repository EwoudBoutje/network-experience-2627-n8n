    {
      "parameters": {
        "jsCode": "\nconst headers = $input.first().json.headers ?? {};\nconst rNumber =\n    headers['x-authentik-username'] ??\n    headers['x-authentik-user'] ??\n    'r0982191';\n\nconst safeRNumber = String(rNumber).replace(/[&<>\"']/g, char => ({\n    '&': '&amp;',\n    '<': '&lt;',\n    '>': '&gt;',\n    '\"': '&quot;',\n    \"'\": '&#39;'\n})[char]);\n\nconst html = `\n<!DOCTYPE html>\n<html lang=\"nl\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Minecraft Whitelist Portal</title>\n<style>\n    body {\n        font-family: Arial, sans-serif;\n        background: #111827;\n        color: white;\n        display: flex;\n        justify-content: center;\n        align-items: center;\n        min-height: 100vh;\n        margin: 0;\n    }\n    .container {\n        background: #1f2937;\n        padding: 35px;\n        border-radius: 14px;\n        width: 90%;\n        max-width: 450px;\n    }\n    .account {\n        background: #374151;\n        padding: 15px;\n        border-radius: 8px;\n        margin: 20px 0;\n    }\n    input, button {\n        box-sizing: border-box;\n        width: 100%;\n        padding: 13px;\n        margin-top: 10px;\n        border-radius: 7px;\n        font-size: 15px;\n    }\n    input {\n        background: #111827;\n        border: 1px solid #4b5563;\n        color: white;\n    }\n    button {\n        background: #16a34a;\n        border: none;\n        color: white;\n        font-weight: bold;\n        cursor: pointer;\n    }\n    .tag {\n        color: #9ca3af;\n        font-size: 13px;\n    }\n</style>\n</head>\n<body>\n<div class=\"container\">\n    <h1>Minecraft Whitelist Portal</h1>\n    <p>Registreer je Minecraft Java-account.</p>\n\n    <div class=\"account\">\n        <div class=\"tag\">Aangemeld schoolaccount</div>\n        <h2>${safeRNumber}</h2>\n    </div>\n\n    <form method=\"POST\" action=\"/webhook/minecraft-portal\">\n        <label for=\"username\">Minecraft Java-username</label>\n        <input\n            id=\"username\"\n            name=\"minecraft_username\"\n            type=\"text\"\n            placeholder=\"Bijvoorbeeld Steve123\"\n            minlength=\"3\"\n            maxlength=\"16\"\n            pattern=\"[A-Za-z0-9_]{3,16}\"\n            required\n        >\n        <button type=\"submit\">Registreren en whitelisten</button>\n    </form>\n</div>\n</body>\n</html>\n`;\n\nreturn [{ json: { html, rNumber } }];\n"
      },
